# Machine-specific app config (copy config.example.json -> config.json and edit)
config.json

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
.claude/launch.json

# Python / editor cruft
__pycache__/
*.pyc
*.tmp
_smoke_config.json
_localdata/
.DS_Store

# Crash-proof app log -- written every session on every rig; the per-rig
# debug_report_*.txt (from send_debug.bat) is the committable debug channel
debug.log

# Assetto Corsa crash reports (may contain a memory dump + your username)
*.dmp
*.report

# Live setup written by the BL Setup Capture Lua companion
current_setup.ini
